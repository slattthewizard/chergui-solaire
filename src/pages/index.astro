        <span style="font-size:13px;font-weight:700;color:#B14A2A;letter-spacing:0.04em;text-transform:uppercase;">En savoir plus &#8594;</span>
      </a>
      <a href="/pompage-solaire/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #E5DDCC;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(23,58,69,0.06);">
