      </div>
      <div style="position:absolute;bottom:-18px;right:-14px;background:#B14A2A;color:#fff;border-radius:14px;padding:14px 22px;box-shadow:0 10px 26px rgba(177,74,42,0.4);">
        <p style="font-family:'DM Sans',sans-serif;font-size:20px;font-weight:800;margin:0;line-height:1;">3-10</p>
